<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fu.edu.sba301.ui.controller.StudentController">
    <top>
        <Label text="Student Management"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </top>
    <center>
        <VBox spacing="10">
            <GridPane hgap="10" vgap="8">
                <Label text="Email" GridPane.rowIndex="0"/>
                <TextField fx:id="txtEmail"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>
                <Label text="First name" GridPane.rowIndex="1"/>
                <TextField fx:id="txtFirstName"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>
                <Label text="Last name" GridPane.rowIndex="2"/>
                <TextField fx:id="txtLastName"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>
                <Label text="Marks" GridPane.rowIndex="3"/>
                <TextField fx:id="txtMarks"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Create" onAction="#handleCreate"/>
                <Button text="Update" onAction="#handleUpdate"/>
                <Button text="Delete" onAction="#handleDelete"/>
                <Button text="Clear" onAction="#handleClear"/>
                <Button text="Refresh" onAction="#handleRefresh"/>
            </HBox>
            <TableView fx:id="tblStudents" prefHeight="360">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="130"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="130"/>
                    <TableColumn fx:id="colMarks" text="Marks" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
